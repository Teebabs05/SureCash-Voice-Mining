DATABASE_URL="postgresql://user:password@localhost:5432/surecash_voice_mining?schema=public"

# Auth
JWT_SECRET=""
JWT_REFRESH_SECRET=""
COOKIE_SECURE="false"

# Encrypts payment gateway keys entered via Admin > Settings at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENCRYPTION_KEY=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_NAME="SureCash Mining"

# Email (stub provider by default - logs to console)
EMAIL_PROVIDER="console"
EMAIL_FROM="no-reply@surecash.app"
RESEND_API_KEY=""

# Voice AI provider: "stub" | "whisper" | "gemini" | "azure"
VOICE_AI_PROVIDER="stub"
OPENAI_API_KEY=""
GEMINI_API_KEY=""
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION=""

# Payment gateways (stub by default)
PAYSTACK_SECRET_KEY=""

# Monnify (by Moniepoint). MONNIFY_BASE_URL defaults to production
# (https://api.monnify.com); use https://sandbox.monnify.com to test.
# MONNIFY_CONTRACT_CODE and MONNIFY_WALLET_ACCOUNT_NUMBER come from your
# Monnify dashboard. Webhook URL to configure there: <your-domain>/api/webhooks/monnify
MONNIFY_API_KEY=""
MONNIFY_SECRET_KEY=""
MONNIFY_CONTRACT_CODE=""
MONNIFY_WALLET_ACCOUNT_NUMBER=""
MONNIFY_BASE_URL=""

# Korapay. Webhook URL to configure in their dashboard: <your-domain>/api/webhooks/korapay
KORAPAY_SECRET_KEY=""

# PayVessel - withdrawal payouts only (their deposit product is dedicated
# virtual accounts, a different modality not wired up here).
# Webhook URL to configure: <your-domain>/api/webhooks/payvessel
PAYVESSEL_API_KEY=""
PAYVESSEL_SECRET_KEY=""

# SMS/OTP provider: "console" (default, logs to console) | "termii"
OTP_PROVIDER="console"
TERMII_API_KEY=""
TERMII_SENDER_ID="SureCash"

# WhatsApp Business Cloud API (Meta) - a no-op notification channel until
# both are set. Only sent to users with a verified phone number. Free-form
# text only works within Meta's 24h customer-service window; for proactive
# notifications outside it, set WHATSAPP_TEMPLATE_NAME to a template
# pre-approved in Meta Business Manager (falls back to free text otherwise).
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE_NAME=""
WHATSAPP_TEMPLATE_LANGUAGE="en_US"

# reCAPTCHA (no-op / always-pass when unset)
RECAPTCHA_SECRET_KEY=""
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""

# Flutterwave. FLUTTERWAVE_WEBHOOK_HASH must match the secret hash string you
# set in the Flutterwave dashboard's webhook settings (not an HMAC - they
# echo it back verbatim in the verif-hash header). Webhook URL to configure
# there: <your-domain>/api/webhooks/flutterwave
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_WEBHOOK_HASH=""

# Web push (VAPID) - generate with: npx web-push generate-vapid-keys
# Push send is a no-op until both keys are set
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@surecash.app"

# Which gateway attempts instant withdrawal payouts: "PAYSTACK" (default) | "MONNIFY" | "KORAPAY" | "PAYVESSEL" | "BILLSTACK" | "FLUTTERWAVE"
DEFAULT_PAYOUT_PROVIDER="PAYSTACK"

# Binance Withdraw API - automatic USDT payout on withdrawal requests
# (TRC20/ERC20/BEP20 -> TRX/ETH/BSC). A no-op (manual-only, same as before)
# until both are set. Use an IP-restricted key/sub-account, not your main
# account, given a crypto send has no chargeback path if something goes
# wrong. No webhook exists for this provider - see the admin withdrawals
# page's "Check Binance status" action for confirmation instead.
BINANCE_API_KEY=""
BINANCE_SECRET_KEY=""

# BillStack (billstack.co) - dedicated virtual accounts for wallet funding + instant bank payouts.
# Set the webhook URL in the BillStack dashboard to:
#   <your-domain>/api/webhooks/billstack?token=<BILLSTACK_WEBHOOK_SECRET>
BILLSTACK_SECRET_KEY=""
BILLSTACK_PUBLIC_KEY=""
BILLSTACK_WEBHOOK_SECRET=""

# Rate limiting: in-memory (per-process) when unset - fine for a single
# instance. Set both to use Upstash Redis instead, required once running
# more than one server instance so limits are shared across processes.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
