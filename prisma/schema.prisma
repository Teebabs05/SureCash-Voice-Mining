// SureCash Mining Platform — database schema
// See SureCash_Mining_Master_Plan for the module list this backs.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  USER
  ADMIN
  SUPERADMIN
}

enum WalletType {
  MAIN
  ENGAGEMENT
  SALES
}

enum TxnType {
  CREDIT
  DEBIT
}

enum TxnReason {
  DAILY_MINING
  VOICE_TASK_REWARD
  TASK_REWARD
  REFERRAL_BONUS
  DEPOSIT
  WITHDRAWAL
  WITHDRAWAL_REVERSAL
  ADMIN_ADJUSTMENT
  SPIN_REWARD
  MISSION_REWARD
  LEVEL_UP_BONUS
  WALLET_TRANSFER
  PLAN_ACTIVATION
  PLAN_COMMISSION
  SPONSORED_POST_REWARD
  EXTRA_SPIN_PURCHASE
  MINING_PLAN_PURCHASE
  MINING_PLAN_PAYOUT
  AD_REWARD
  BILLS_PURCHASE
}

enum SponsoredPlatform {
  FACEBOOK
  INSTAGRAM
  TIKTOK
  WHATSAPP
}

enum SponsoredShareStatus {
  APPROVED
  REJECTED
}

enum VoiceRecordingStatus {
  PENDING
  PROCESSING
  APPROVED
  REJECTED
  FLAGGED
}

enum DepositMethod {
  MANUAL_BANK
  PAYSTACK
  MONNIFY
  KORAPAY
  PAYVESSEL
  FLUTTERWAVE
  BILLSTACK
}

enum UserTier {
  FREE
  SILVER
  GOLD
  VIP
}

enum KycStatus {
  UNVERIFIED
  PENDING
  APPROVED
  REJECTED
}

enum SupportTicketStatus {
  OPEN
  ANSWERED
  CLOSED
}

enum PayoutProvider {
  MANUAL
  PAYSTACK
  MONNIFY
  KORAPAY
  PAYVESSEL
  BILLSTACK
  FLUTTERWAVE
  BINANCE
}

enum WithdrawalMethod {
  BANK
  USDT
}

enum CryptoNetwork {
  TRC20
  ERC20
  BEP20
}

enum DepositStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WithdrawalStatus {
  PENDING
  OTP_REQUIRED
  PROCESSING
  APPROVED
  REJECTED
  PAID
}

enum NotificationType {
  SYSTEM
  WALLET
  VOICE_TASK
  REFERRAL
  ADMIN
  SECURITY
  GAMIFICATION
}

enum FraudSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FraudStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

enum OtpPurpose {
  BANK_ACCOUNT_CHANGE
  WITHDRAWAL
  EMAIL_VERIFICATION
  LOGIN_2FA
  PHONE_VERIFICATION
}

// ---------------------------------------------------------------------------
// Core identity
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  phone        String?  @unique
  passwordHash String
  fullName     String
  role         UserRole @default(USER)

  emailVerified             Boolean   @default(false)
  phoneVerified             Boolean   @default(false)
  isBanned                  Boolean   @default(false)
  banReason                 String?
  withdrawalsLocked         Boolean   @default(false)
  withdrawalLockNote        String?
  tier                      UserTier  @default(FREE)
  avatarUrl                 String?
  emailNotificationsEnabled Boolean   @default(true)
  loginAlertsEnabled        Boolean   @default(true)
  kycStatus                 KycStatus @default(UNVERIFIED)
  // Set the first time the "join our community" prompt is shown (fires once,
  // on the first login that happens >=24h after signup) - null means not
  // shown yet.
  communityPromptSeenAt     DateTime?

  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?

  facebookUrl     String?
  instagramHandle String?
  tiktokHandle    String?

  planId          String?
  plan            Plan?     @relation(fields: [planId], references: [id])
  planActivatedAt DateTime?

  referralCode String  @unique
  referredById String?
  referredBy   User?   @relation("Referrals", fields: [referredById], references: [id])
  referrals    User[]  @relation("Referrals")

  xp            Int       @default(0)
  level         Int       @default(1)
  streakCount   Int       @default(0)
  longestStreak Int       @default(0)
  lastMiningAt  DateTime?
  lastCheckInAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wallets                   Wallet[]
  walletTransactions        WalletTransaction[]
  voiceRecordings           VoiceRecording[]
  referralRecordsAsReferrer Referral[]               @relation("ReferrerRecords")
  referralRecordsAsReferred Referral[]               @relation("ReferredRecords")
  deposits                  Deposit[]
  withdrawals               Withdrawal[]
  bankAccounts              BankAccount[]
  cryptoWallets             CryptoWallet[]
  virtualAccount            VirtualAccount?
  achievements              UserAchievement[]
  notifications             Notification[]
  devices                   Device[]
  pushSubscriptions         PushSubscription[]
  deviceTokens              DeviceToken[]
  fraudReports              FraudReport[]            @relation("FraudSubject")
  fraudReportsReviewed      FraudReport[]            @relation("FraudReviewer")
  missionProgress           UserMissionProgress[]
  taskCompletions           UserTaskCompletion[]
  spinHistory               SpinHistory[]
  otpCodes                  OtpCode[]
  auditLogs                 AuditLog[]
  emailVerificationTokens   EmailVerificationToken[]
  passwordResetTokens       PasswordResetToken[]
  sessions                  Session[]
  adminProfile              AdminProfile?
  promoCodeRedemptions      PromoCodeRedemption[]
  supportTickets            SupportTicket[]
  supportTicketReplies      SupportTicketReply[]
  sponsoredShares           SponsoredShare[]
  miningPlanInvestments     UserMiningPlan[]
  adWatches                 AdWatch[]
  kycDocuments              KycDocument[]
  webauthnCredentials       WebAuthnCredential[]
  billPurchases             BillPurchase[]

  @@index([referredById])
  @@index([role])
}

// A registered biometric/passkey credential (Face ID, fingerprint, Windows
// Hello, etc.) - registered as a discoverable/resident credential so login
// works without the user typing their email first. "Biometric enabled" in
// the UI just means this user has at least one row here.
model WebAuthnCredential {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String    @unique
  publicKey    String
  counter      Int       @default(0)
  deviceLabel  String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@index([userId])
}

model AdminProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  department  String?
  permissions Json     @default("[]")
  createdAt   DateTime @default(now())
}

// Server-side record backing each issued JWT session cookie, so sessions can
// be listed and individually revoked ("log out other devices") — the JWT
// itself only proves identity; this table is checked on every request to
// confirm the session hasn't been revoked or expired.
model Session {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model OtpCode {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   OtpPurpose
  codeHash  String
  metadata  Json?
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int        @default(0)
  createdAt DateTime   @default(now())

  @@index([userId, purpose])
}

// ---------------------------------------------------------------------------
// Wallets & payments
// ---------------------------------------------------------------------------

model Wallet {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      WalletType
  balance   Decimal    @default(0) @db.Decimal(18, 2)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  transactions WalletTransaction[]

  @@unique([userId, type])
}

model WalletTransaction {
  id           String    @id @default(cuid())
  walletId     String
  wallet       Wallet    @relation(fields: [walletId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         TxnType
  reason       TxnReason
  amount       Decimal   @db.Decimal(18, 2)
  balanceAfter Decimal   @db.Decimal(18, 2)
  reference    String    @unique
  description  String?
  metadata     Json?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([walletId])
}

model Deposit {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount       Decimal       @db.Decimal(18, 2)
  method       DepositMethod
  reference    String        @unique
  receiptUrl   String?
  receiptHash  String?
  status       DepositStatus @default(PENDING)
  gatewayData  Json?
  verifiedById String?
  verifiedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([userId])
  @@index([status])
  @@index([receiptHash])
}

model BankAccount {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankName              String
  bankCode              String
  accountNumber         String
  accountName           String
  // Set automatically when a bank verification API resolved this account
  // number to a real account name (the "instant bank account detection"
  // flow) — distinct from `isVerified`, which tracks the separate OTP step
  // confirming the account owner authorized adding this payout destination.
  autoVerified          Boolean   @default(false)
  isVerified            Boolean   @default(false)
  isPrimary             Boolean   @default(false)
  paystackRecipientCode String?
  // Set once an admin has manually reviewed an account that couldn't be
  // auto-verified (no bank API configured, or the lookup failed) — see
  // Admin > Bank Accounts. Approving sets autoVerified; rejecting clears
  // isVerified so the account can't be used for a withdrawal until fixed.
  reviewedAt            DateTime?
  reviewedById          String?
  reviewNote            String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  withdrawals Withdrawal[]

  @@unique([userId, accountNumber, bankCode])
}

/**
 * A permanent dedicated bank account number (NUBAN) tied to one user for
 * wallet funding — any bank transfer into it is credited automatically via
 * the provider's webhook, no checkout redirect involved.
 */
model VirtualAccount {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider      String   @default("BILLSTACK")
  accountNumber String
  accountName   String
  bankName      String
  externalRef   String?
  createdAt     DateTime @default(now())
}

model CryptoWallet {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  address    String
  network    CryptoNetwork
  // OTP-confirmed ownership, mirroring BankAccount.isVerified — crypto
  // addresses have no name-resolution API to auto-verify against, so this
  // OTP step is the only ownership confirmation available.
  isVerified Boolean       @default(false)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  withdrawals Withdrawal[]

  @@unique([userId, address, network])
}

model Withdrawal {
  id                  String           @id @default(cuid())
  userId              String
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  method              WithdrawalMethod @default(BANK)
  // Withdrawals only ever draw from ENGAGEMENT or SALES (never MAIN, which
  // is reserved for site spending like Bills/VTU) - kept for the record.
  walletType          WalletType       @default(ENGAGEMENT)
  bankAccountId       String?
  bankAccount         BankAccount?     @relation(fields: [bankAccountId], references: [id])
  cryptoWalletId      String?
  cryptoWallet        CryptoWallet?    @relation(fields: [cryptoWalletId], references: [id])
  usdtAmount          Decimal?         @db.Decimal(18, 2)
  amount              Decimal          @db.Decimal(18, 2)
  fee                 Decimal          @default(0) @db.Decimal(18, 2)
  reference           String           @unique
  status              WithdrawalStatus @default(PENDING)
  otpVerifiedAt       DateTime?
  payoutProvider      PayoutProvider   @default(MANUAL)
  payoutReference     String?
  autoPayoutAttempted Boolean          @default(false)
  autoPayoutError     String?
  processedById       String?
  processedAt         DateTime?
  rejectionReason     String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([userId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Bills & VTU (airtime, data, electricity, cable TV)
// ---------------------------------------------------------------------------

enum BillProvider {
  VTU_NG
  VTUAFRICA
}

enum BillServiceType {
  AIRTIME
  DATA
  ELECTRICITY
  CABLE_TV
  AIRTIME_TO_CASH
  EPIN
  BETTING
}

enum BillPurchaseStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  REFUNDED
}

/**
 * A single VTU/bills transaction. For every serviceType except
 * AIRTIME_TO_CASH this always debits the user's MAIN wallet (never
 * ENGAGEMENT/SALES, which are earnings-only; see the comment on
 * Withdrawal.walletType above) - `amount` is what was debited.
 * AIRTIME_TO_CASH runs the opposite direction: nothing is debited up
 * front, `amount` is the airtime value the user claims to have sent, and
 * `creditAmount` (only set once VTUAfrica's webhook confirms receipt) is
 * what actually lands in ENGAGEMENT - always less than `amount` since
 * VTUAfrica takes a conversion fee.
 *
 * PENDING/PROCESSING means the provider hasn't confirmed the outcome yet.
 * For VTU.ng, the requery endpoint (see src/lib/payments/vtu-provider.ts)
 * is the source of truth, since their own docs say the "completed"
 * webhook only fires for admin-manually-triggered completions. VTUAfrica
 * has no confirmed requery endpoint at all (see vtuafrica.ts) - only
 * AIRTIME_TO_CASH is webhook-confirmed there; everything else resolves
 * synchronously from VTUAfrica's own purchase-call response.
 */
model BillPurchase {
  id               String             @id @default(cuid())
  userId           String
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider         BillProvider
  serviceType      BillServiceType
  serviceId        String // provider's own service code, e.g. "mtn", "dstv", "ikeja-electric"
  variationId      String? // data plan / cable bouquet / meter type - not used for airtime
  recipient        String // phone number, meter number, or smartcard/IUC number
  amount           Decimal            @db.Decimal(18, 2) // amount debited from MAIN, or (AIRTIME_TO_CASH) the claimed airtime value
  creditAmount     Decimal?           @db.Decimal(18, 2) // AIRTIME_TO_CASH only - actual amount credited to ENGAGEMENT once confirmed
  reference        String             @unique // our own reference, sent to the provider as its request/order id
  providerOrderId  String?
  status           BillPurchaseStatus @default(PENDING)
  token            String? // electricity prepaid token
  units            String? // electricity units purchased
  pins             Json? // EPIN only - array of recharge card PINs printed
  providerResponse Json?
  errorMessage     String?
  processedAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([userId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Voice AI mining
// ---------------------------------------------------------------------------

model VoiceTask {
  id           String   @id @default(cuid())
  title        String
  promptText   String
  language     String   @default("en")
  category     String   @default("session") // "session" | "word_game" - selects which Plan reward field applies
  syllables    String? // e.g. "Op-por-tu-ni-ty" - shown under the word in Word Game to help pronunciation
  rewardAmount Decimal  @db.Decimal(18, 2)
  dailyLimit   Int      @default(5)
  minDuration  Int      @default(3)
  maxDuration  Int      @default(30)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  recordings VoiceRecording[]
}

model VoiceRecording {
  id           String               @id @default(cuid())
  userId       String
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  voiceTaskId  String
  voiceTask    VoiceTask            @relation(fields: [voiceTaskId], references: [id])
  audioUrl     String
  audioHash    String
  durationSec  Float
  status       VoiceRecordingStatus @default(PENDING)
  rewardAmount Decimal?             @db.Decimal(18, 2)
  deviceId     String?
  device       Device?              @relation(fields: [deviceId], references: [id])
  createdAt    DateTime             @default(now())
  reviewedAt   DateTime?

  aiResult AiResult?

  @@index([userId])
  @@index([audioHash])
  @@index([voiceTaskId])
}

model AiResult {
  id                 String         @id @default(cuid())
  recordingId        String         @unique
  recording          VoiceRecording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  provider           String
  transcript         String?
  confidence         Float
  isDuplicate        Boolean        @default(false)
  isReplayAttack     Boolean        @default(false)
  hasBackgroundNoise Boolean        @default(false)
  isSynthesizedVoice Boolean        @default(false)
  passed             Boolean
  rawResponse        Json?
  createdAt          DateTime       @default(now())
}

// ---------------------------------------------------------------------------
// Plans (paid membership tiers - admin-editable pricing/rewards)
// ---------------------------------------------------------------------------

model Plan {
  id                  String  @id @default(cuid())
  name                String
  price               Decimal @db.Decimal(18, 2)
  voiceSessionReward  Decimal @db.Decimal(18, 2)
  wordGameReward      Decimal @db.Decimal(18, 2)
  sponsoredPostReward Decimal @db.Decimal(18, 2)
  taskReward          Decimal @db.Decimal(18, 2)
  referralCommission  Decimal @db.Decimal(18, 2)
  sortOrder           Int     @default(0)
  isActive            Boolean @default(true)
  isPopular           Boolean @default(false)

  // Per-plan daily quantity caps - every plan can access every activity;
  // what differs per plan is how many times per day each section can be
  // used. 9999 is the "effectively unlimited" convention used by the top
  // tier and by any newly created plan until an admin dials it in.
  voiceEarnDailyLimit      Int @default(9999)
  wordGameDailyLimit       Int @default(9999)
  taskCenterDailyLimit     Int @default(9999)
  sponsoredPostsDailyLimit Int @default(9999)
  spinDailyLimit           Int @default(9999)
  watchAdsDailyLimit       Int @default(9999)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]
}

// Investment-style mining products - distinct from the free daily-claim
// "Daily Mining" streak feature. A user buys in at `price`, then earns a
// fixed `dailyReturn` credited to their wallet once a day for
// `durationDays`, after which the investment ends. Unlike Plan (a
// permanent rate-boost subscription), this has a principal, a payout
// schedule, and an expiry.
model MiningPlan {
  id           String   @id @default(cuid())
  name         String
  price        Decimal  @db.Decimal(18, 2)
  dailyReturn  Decimal  @db.Decimal(18, 2)
  durationDays Int      @default(30)
  description  String?
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  investments UserMiningPlan[]
}

enum UserMiningPlanStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model UserMiningPlan {
  id             String               @id @default(cuid())
  userId         String
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId         String
  plan           MiningPlan           @relation(fields: [planId], references: [id])
  amountInvested Decimal              @db.Decimal(18, 2)
  totalEarned    Decimal              @default(0) @db.Decimal(18, 2)
  startedAt      DateTime             @default(now())
  nextPayoutAt   DateTime
  endsAt         DateTime
  status         UserMiningPlanStatus @default(ACTIVE)
  createdAt      DateTime             @default(now())

  payouts MiningPlanPayout[]

  @@index([userId])
  @@index([status])
  @@index([nextPayoutAt])
}

model MiningPlanPayout {
  id               String         @id @default(cuid())
  userMiningPlanId String
  userMiningPlan   UserMiningPlan @relation(fields: [userMiningPlanId], references: [id], onDelete: Cascade)
  userId           String
  amount           Decimal        @db.Decimal(18, 2)
  createdAt        DateTime       @default(now())

  @@index([userId])
  @@index([userMiningPlanId])
}

// ---------------------------------------------------------------------------
// Referrals
// ---------------------------------------------------------------------------

model Referral {
  id             String   @id @default(cuid())
  referrerId     String
  referrer       User     @relation("ReferrerRecords", fields: [referrerId], references: [id], onDelete: Cascade)
  referredId     String   @unique
  referred       User     @relation("ReferredRecords", fields: [referredId], references: [id], onDelete: Cascade)
  rewardAmount   Decimal  @default(0) @db.Decimal(18, 2)
  rewardCredited Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([referrerId])
}

// ---------------------------------------------------------------------------
// Gamification
// ---------------------------------------------------------------------------

model Level {
  level       Int     @id
  title       String
  xpRequired  Int
  bonusAmount Decimal @default(0) @db.Decimal(18, 2)
}

model Achievement {
  id          String @id @default(cuid())
  code        String @unique
  title       String
  description String
  icon        String @default("trophy")
  xpReward    Int    @default(0)

  users UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id])
  earnedAt      DateTime    @default(now())

  @@unique([userId, achievementId])
}

model DailyMission {
  id           String     @id @default(cuid())
  title        String
  description  String
  type         String
  target       Int        @default(1)
  rewardXp     Int        @default(0)
  rewardAmount Decimal    @default(0) @db.Decimal(18, 2)
  rewardWallet WalletType @default(ENGAGEMENT)
  isActive     Boolean    @default(true)

  progress UserMissionProgress[]
}

model UserMissionProgress {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  missionId String
  mission   DailyMission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  date      DateTime     @default(now()) @db.Date
  progress  Int          @default(0)
  completed Boolean      @default(false)
  claimedAt DateTime?

  @@unique([userId, missionId, date])
}

model SpinReward {
  id       String     @id @default(cuid())
  label    String
  amount   Decimal    @db.Decimal(18, 2)
  wallet   WalletType @default(ENGAGEMENT)
  weight   Int        @default(1)
  colorHex String     @default("#0D8A82")
  isActive Boolean    @default(true)

  history SpinHistory[]
}

model SpinHistory {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  spinRewardId String
  spinReward   SpinReward @relation(fields: [spinRewardId], references: [id])
  createdAt    DateTime   @default(now())

  @@index([userId])
}

// One row per completed "watch to earn" - a simple timed placeholder (no
// real ad network integrated yet; swap in a real rewarded-ad SDK later by
// changing what the client shows during the countdown, the reward/anti-abuse
// logic here doesn't need to change).
model AdWatch {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rewardAmount Decimal  @db.Decimal(18, 2)
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// A user's identity-verification submissions. Approving one flips
// User.kycStatus to APPROVED - nothing else in the app currently gates on
// that status, so KYC review is informational/compliance record-keeping
// for now rather than a hard requirement to unlock a feature.
model KycDocument {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentType String
  fileUrl      String
  status       KycStatus @default(PENDING)
  adminNote    String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Task center
// ---------------------------------------------------------------------------

model TaskCenterTask {
  id            String   @id @default(cuid())
  title         String
  description   String
  type          String
  actionUrl     String?
  rewardAmount  Decimal  @db.Decimal(18, 2)
  isRepeatable  Boolean  @default(false)
  requiresProof Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  completions UserTaskCompletion[]
}

model UserTaskCompletion {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId         String
  task           TaskCenterTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  status         String         @default("completed")
  proofUrl       String?
  proofText      String?
  proofImageUrl  String?
  proofImageHash String?
  rewardPaid     Decimal        @db.Decimal(18, 2)
  // Set once an admin approves/rejects a "PENDING_REVIEW" submission - stays
  // null for tasks that don't require proof (those pay out immediately).
  reviewedAt     DateTime?
  reviewedById   String?
  adminNote      String?
  createdAt      DateTime       @default(now())

  @@index([userId])
  @@index([proofImageHash])
  @@index([status])
}

// A single active campaign (caption/link/banner/reward) lives in Setting
// (sponsored_post_*) — this table only tracks individual share attempts, one
// per user per platform per day.
model SponsoredShare {
  id             String               @id @default(cuid())
  userId         String
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform       SponsoredPlatform
  date           DateTime
  status         SponsoredShareStatus
  proofImageUrl  String
  proofImageHash String
  rewardPaid     Decimal              @db.Decimal(18, 2)
  reviewNote     String?
  createdAt      DateTime             @default(now())

  @@unique([userId, platform, date])
  @@index([proofImageHash])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Admin, security, notifications
// ---------------------------------------------------------------------------

model Notification {
  id          String           @id @default(cuid())
  userId      String?
  user        User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  body        String
  type        NotificationType @default(SYSTEM)
  isRead      Boolean          @default(false)
  isBroadcast Boolean          @default(false)
  createdAt   DateTime         @default(now())

  @@index([userId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

// Firebase Cloud Messaging tokens for the native Android app - separate
// from PushSubscription, which is browser Web Push (VAPID) and can't
// reach a WebView-based app. See src/lib/server/fcm.ts.
model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String   @default("android")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Device {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fingerprint    String
  userAgent      String?
  ipAddress      String?
  isTrusted      Boolean  @default(false)
  isVpnSuspected Boolean  @default(false)
  lastSeenAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  recordings VoiceRecording[]

  @@unique([userId, fingerprint])
}

model FraudReport {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation("FraudSubject", fields: [userId], references: [id], onDelete: Cascade)
  type         String
  details      String
  severity     FraudSeverity @default(LOW)
  status       FraudStatus   @default(OPEN)
  reviewedById String?
  reviewedBy   User?         @relation("FraudReviewer", fields: [reviewedById], references: [id])
  createdAt    DateTime      @default(now())
  resolvedAt   DateTime?

  @@index([userId])
  @@index([status])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// Admin-entered payment/notification gateway keys (encrypted at rest via
// src/lib/server/crypto.ts). Values here take precedence over the matching
// .env var — see src/lib/server/credentials.ts.
model IntegrationCredential {
  key            String   @id
  // @db.Text, not the default VARCHAR(191) - some values (e.g. a PEM RSA
  // private key) run well past 191 chars once AES-GCM encrypted, and would
  // silently truncate on save otherwise, corrupting the stored value.
  encryptedValue String   @db.Text
  updatedAt      DateTime @updatedAt
  updatedById    String?
}

// ---------------------------------------------------------------------------
// Promo codes & support
// ---------------------------------------------------------------------------

model PromoCode {
  id              String     @id @default(cuid())
  code            String     @unique
  amount          Decimal    @db.Decimal(18, 2)
  wallet          WalletType @default(ENGAGEMENT)
  maxRedemptions  Int        @default(1)
  redemptionCount Int        @default(0)
  expiresAt       DateTime?
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())

  redemptions PromoCodeRedemption[]
}

model PromoCodeRedemption {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  promoCodeId String
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([userId, promoCodeId])
}

model SupportTicket {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  message   String
  status    SupportTicketStatus @default(OPEN)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  replies SupportTicketReply[]
}

model SupportTicketReply {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation(fields: [authorId], references: [id])
  message   String
  isAdmin   Boolean       @default(false)
  createdAt DateTime      @default(now())

  @@index([ticketId])
}
